# Copy to .env. Every value here is per-environment; nothing environment-specific is compiled in.

NODE_ENV=development
# Names this deployment. Tagged on error reports, shown by the API, and the hook the
# non-production banner hangs on (ticket 02).
ENVIRONMENT_NAME=development
PORT=3000
LOG_LEVEL=info

# Local Postgres from docker-compose.yml. `pnpm db:up` starts it.
DATABASE_URL=postgres://ricambi:ricambi@localhost:5433/ricambi
# The API test seam runs against a real Postgres of its own.
TEST_DATABASE_URL=postgres://ricambi:ricambi@localhost:5433/ricambi_test

# Where the built single-page app lives. Unset in development — Vite serves it instead.
# WEB_DIST_PATH=../web/dist

# Error reporting. Must be a Sentry EU-region DSN; the API refuses to start otherwise.
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# `none` refuses to send; `memory` captures mail for inspection.
EMAIL_TRANSPORT=none

# `none` refuses every webhook delivery. Stripe arrives with ticket 18.
PAYMENT_PROVIDER=none
