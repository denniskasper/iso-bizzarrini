# Copy to .env. Every value here is per-environment; nothing environment-specific is compiled in.

NODE_ENV=development
# Names this deployment. Shown by the API and in the status strip at the foot of every page.
ENVIRONMENT_NAME=development
# Whether this is the real archive: `production` or `non-production`.
#
# Anything that is not the word `production` is treated as practice — an unset value included,
# and deliberately so. A production system wearing a DEMO banner is embarrassing and instantly
# visible; a practice system passing itself off as the archive is the failure worth engineering
# against. Set `production` once, in writing, on the machine that really is the archive.
#
# In a non-production environment the application refuses to start if it has been handed an
# e-mail transport that can reach a real person, a payment provider pointed at real mandates, or
# renewal reminders switched on.
ENVIRONMENT_MODE=non-production
PORT=3000
LOG_LEVEL=info

# Local Postgres from docker-compose.yml. `pnpm db:up` starts it.
DATABASE_URL=postgres://ricambi:ricambi@localhost:5433/ricambi
# The API test seam runs against a real Postgres of its own.
TEST_DATABASE_URL=postgres://ricambi:ricambi@localhost:5433/ricambi_test

# `pnpm demo` runs the built app as a non-production system, with its own database and its own
# generated catalog. Nothing is ever copied into it from anywhere real.
DEMO_DATABASE_URL=postgres://ricambi:ricambi@localhost:5433/ricambi_demo
DEMO_PORT=3200
DEMO_ENVIRONMENT_NAME=demo

# Where the built single-page app lives. Unset in development — Vite serves it instead.
# WEB_DIST_PATH=../web/dist

# There is no error-tracking vendor (ADR 0011). Unhandled errors are logged here, on the box.

# `log` writes every letter whole to the log, `memory` captures it for a test to read, and
# `none` refuses to send at all.
#
# Invitations and password resets leave through here, so this is what decides whether an
# Administrator can add anybody at all: with `none` the archive refuses to send rather than
# quietly dropping the letter. `log` is the laptop's mail catcher — the invitation appears in
# the terminal running `pnpm dev` and the link in it is clicked by hand.
EMAIL_TRANSPORT=log

# Where a browser reaches this system. The only thing it is used for is the link inside an
# invitation or a reset e-mail, so it has to be the address the *member* types — in development
# that is Vite, not the API. Production refuses to start pointing invitations at a laptop.
PUBLIC_URL=http://localhost:5173

# Whether a password a member chooses is checked against a known-breached-password range API
# (ADR 0003), which is the one password rule that is about the password rather than its shape.
# The default is the real check; `none` is how a laptop with no network opts out. The password
# itself never leaves this process either way — only the first five characters of its SHA-1 go
# out, naming a bucket of some hundreds of hashes, and the comparison happens here.
BREACHED_PASSWORD_CHECK=range-api

# `none` refuses every webhook delivery. Stripe arrives with ticket 18.
PAYMENT_PROVIDER=none

# Everybody who reaches this archive is a person on the Club's roster with a password of their
# own, and there is no shared credential of any kind. An empty roster has no Administrator on
# it, so the way into a fresh system is the bootstrap, run once:
#
#   pnpm roster:invite-administrator -- --name "A Person" --email person@example.org
#
# It sets no password. It sends an invitation, and the person it names chooses their own.

# Signs the session cookie. Unset means one is generated at startup, so sessions do not survive
# a restart. There is deliberately no default to leave in place by accident.
# SESSION_SECRET=

# Where scans, photographs and their derived images are written. A directory, and one nothing
# serves: the archive's images are reachable only through the authenticated route (ADR 0006).
# Relative paths are resolved from wherever the API was started.
FILE_STORAGE_PATH=.data/files

# The largest scan ingest will accept, in bytes. An A3 sheet at 600 dpi kept uncompressed is
# around 100 MB, which is the most anyone has suggested this archive might hold.
MAX_SCAN_BYTES=104857600

# The largest photograph of a part, in bytes — a quarter of what a scan may be. A scan is an A3
# sheet somebody put on a flatbed once; a photograph is whatever a phone in a garage produced,
# and 25 MB is already a generous one.
MAX_PHOTOGRAPH_BYTES=26214400

# Whether the application applies its own migrations before it starts listening. On unless this
# says otherwise: a deployment whose schema has not been applied does not fail loudly, it
# answers every request with a 500 against tables that are not there.
MIGRATE_ON_START=true

# What the seeded practice members sign in with, on a system that is not the archive.
#
# Unset, and `pnpm db:seed` leaves every generated member on the roster as *invited* — nobody can
# sign in as one. That direction is deliberate: a password written into this repository would work
# on every practice system ever deployed from it. The browser seam sets its own; set one here only
# if you want to click around a seeded roster by hand.
# PRACTICE_MEMBER_PASSWORD=

# Whether an **empty** practice system writes itself an invented catalog at startup, so a
# preview deployment has something in it to open. Off here — `pnpm dev` is a laptop, and
# `pnpm db:seed` is the command that fills one deliberately. It never truncates, and it is
# refused outright outside a declared non-production environment.
SEED_PRACTICE_ARCHIVE=false

# Renewal reminders (ticket 17). Off unless this says otherwise, so that a first roster import
# cannot mail the whole membership, and refused outright outside production.
REMINDERS_ENABLED=false

# Retention (ADR 0007). How many years an Account is kept after its last Membership ran out
# before the daily sweep deletes it — what the member published stays, under "a former member".
# Three is the proposal; the association confirms the figure. `pnpm roster:retention-sweep --
# --dry-run` shows who a sweep would delete before changing it.
RETENTION_YEARS=3

# How many full calendar years a payment record is kept after the year the money arrived, whether
# or not the person who paid has been erased. The statutory accounting period: ask the treasurer.
PAYMENT_RECORD_RETENTION_YEARS=10
