{
  "name": "@ricambi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --build tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx scripts/seed.ts",
    "scans:measure": "tsx scripts/scan-measurements.ts",
    "archive:load": "tsx scripts/load-archive.ts",
    "catalog:read": "tsx scripts/read-catalog.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "roster:invite-administrator": "tsx src/cli/invite-administrator.ts",
    "roster:retention-sweep": "tsx src/cli/retention-sweep.ts",
    "proposals:export": "tsx src/cli/export-proposals.ts",
    "proposals:import": "tsx src/cli/import-proposals.ts",
    "proposals:fetch": "tsx src/cli/fetch-proposals.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@ricambi/contracts": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.6",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.6",
    "smtp-server": "^3.19.21",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
